;;; emacs-reader-search-progress-test.el --- Search timer lifecycle -*- lexical-binding: t; indent-tabs-mode: nil; fill-column: 100; -*-

;;; Commentary:
;; Exercise search callbacks with real scheduled timers and controlled replies.

;;; Code:
(require 'ert)
(require 'ert-x)
(require 'emacs-reader-search-all)

(defun emacs-reader-progress-test--fire (timer)
  "Run TIMER's callback immediately."
  (apply (timer--function timer) (timer--args timer)))

(ert-deftest emacs-reader-progress-local-animation-and-restoration ()
  (ert-with-test-buffer ()
    (dolist (local '(nil t))
      (if local (setq-local mode-line-format '("%e" (:eval "custom")))
        (kill-local-variable 'mode-line-format))
      (let ((original mode-line-format) timer frame)
        (emacs-reader-search-progress-start)
        (setq timer emacs-reader-search-progress--timer frame emacs-reader-search-progress--text)
        (should (memq timer timer-list))
        (emacs-reader-search-progress-start)
        (should (eq timer emacs-reader-search-progress--timer))
        (should (memq original mode-line-format))
        (ert-with-test-buffer ()
          (should-not emacs-reader-search-progress--timer)
          (emacs-reader-progress-test--fire timer)
          (should-not emacs-reader-search-progress--text))
        (should-not (equal frame emacs-reader-search-progress--text))
        (emacs-reader-search-progress-stop)
        (should (eq mode-line-format original))
        (should (eq local (local-variable-p 'mode-line-format)))
        (should-not (memq timer timer-list))))))

(ert-deftest emacs-reader-progress-single-source-timeout-retry-and-kill ()
  (dolist (native '(nil t))
    (let (reply timers)
      (ert-with-test-buffer ()
        (emacs-reader-search-mode)
        (setq emacs-reader--search-config (list :key "x" :source "source" :native native :page 1))
        (cl-letf (((symbol-function 'emacs-reader--reader3-request)
                   (lambda (_name _method _data cb) (setq reply cb)))
                  ((symbol-function 'emacs-reader-legado-search)
                   (lambda (_source _key cb _page)
                     (setq reply (lambda (_response) (funcall cb nil nil))))))
          (emacs-reader-search-more)
          (setq timers (list emacs-reader-search-progress--timer emacs-reader--search-timeout))
          (should (cl-every (lambda (timer) (memq timer timer-list)) timers))
          (emacs-reader-progress-test--fire emacs-reader--search-timeout)
          (should-not (cl-some (lambda (timer) (memq timer timer-list)) timers))
          (let ((late reply))
            (emacs-reader-search-more)
            (funcall late '(:ok ((isSuccess . t))))
            (should emacs-reader--search-loading)
            (funcall reply '(:ok ((isSuccess . t)))))
          (should-not emacs-reader-search-progress--timer)
          (should emacs-reader--search-ended)
          (setq emacs-reader--search-ended nil)
          (emacs-reader-search-more)
          (setq timers (list emacs-reader-search-progress--timer emacs-reader--search-timeout))))
      (should-not (cl-some (lambda (timer) (memq timer timer-list)) timers))
      (funcall reply nil))))

(ert-deftest emacs-reader-progress-aggregate-queue-more-retry-and-stop ()
  (ert-with-test-buffer ()
    (emacs-reader-all-mode)
    (let ((source '((type . "legado") (name . "Books"))) callbacks)
      (setq emacs-reader-all--tasks (cl-loop repeat 5 collect
                                             (make-emacs-reader-search-task :source source))
            emacs-reader-all--queue (copy-sequence emacs-reader-all--tasks)
            emacs-reader-all--seen (make-hash-table :test #'equal))
      (cl-letf (((symbol-function 'emacs-reader-legado-search)
                 (lambda (_src _key cb _page) (push cb callbacks))))
        (emacs-reader-all--pump)
        (let ((timer emacs-reader-search-progress--timer))
          (should (= 1 (length emacs-reader-all--queue)))
          (funcall (pop callbacks) '((:bookUrl "book" :name "A")) nil)
          (should (eq timer emacs-reader-search-progress--timer))
          (emacs-reader-progress-test--fire (cdar emacs-reader-all--running))
          (should (eq timer emacs-reader-search-progress--timer))
          (while callbacks (funcall (pop callbacks) nil "offline"))
          (should-not (memq timer timer-list)))
        (emacs-reader-all-more)
        (let ((timer emacs-reader-search-progress--timer))
          (should (memq timer timer-list))
          (funcall (pop callbacks) nil nil)
          (should-not (memq timer timer-list)))
        (emacs-reader-all-retry)
        (let ((timers (cons emacs-reader-search-progress--timer
                            (mapcar #'cdr emacs-reader-all--running))))
          (should (cl-every (lambda (timer) (memq timer timer-list)) timers))
          (run-hooks 'quit-window-hook)
          (while callbacks (funcall (pop callbacks) nil nil))
          (should-not (cl-some (lambda (timer) (memq timer timer-list)) timers)))))))

(ert-deftest emacs-reader-progress-catalog-completion-timeout-cancel-and-kill ()
  (dolist (kind '("json" "opds"))
    (dolist (outcome '(complete fail timeout cancel kill))
      (ert-with-test-buffer ()
        (emacs-reader-opds-mode)
        (setq emacs-reader-opds--name "Catalog")
        (let* ((source `((type . ,kind) (url . "https://a.invalid/{query}")))
               (before (copy-sequence timer-list)) (target (current-buffer)) receive worker)
          (cl-letf (((symbol-function 'emacs-reader-opds--get)
                     (lambda (_url _parse cb) (setq receive cb worker (current-buffer)) nil)))
            (emacs-reader-opds--search-buffer source "x")
            (let* ((timer emacs-reader-search-progress--timer)
                   (timers (cl-set-difference timer-list before))
                   (deadline (car (delq timer (copy-sequence timers)))))
              (should (memq timer timers))
              (should (timerp deadline))
              (pcase outcome
                ('complete (with-current-buffer worker
                             (when (equal kind "opds")
                               (funcall receive '(nil . "https://a/{searchTerms}")))
                             (funcall receive
                                      (list (emacs-reader-opds--item
                                             :kind 'feed :next t :pagination t
                                             :url "https://a.invalid/next")))
                             (should (eq timer (buffer-local-value
                                                'emacs-reader-search-progress--timer target)))
                             (let ((pending (cl-set-difference timer-list (cons timer before))))
                               (should (= (length pending) 1))
                               (timer-event-handler (car pending)))
                             (funcall receive nil)))
                ('fail (with-current-buffer worker (funcall emacs-reader-opds--on-error "offline")))
                ('timeout (emacs-reader-progress-test--fire deadline))
                ('cancel (emacs-reader-opds--stop))
                ('kill (kill-buffer (current-buffer))))
              (should-not (buffer-live-p worker))
              (should-not (cl-some (lambda (entry) (memq entry timer-list)) timers)))))))))

(provide 'emacs-reader-search-progress-test)
;;; emacs-reader-search-progress-test.el ends here
