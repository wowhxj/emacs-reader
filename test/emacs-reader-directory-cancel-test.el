;;; emacs-reader-directory-cancel-test.el --- Directory cancellation tests -*- lexical-binding: t; indent-tabs-mode: nil; fill-column: 100; -*-
;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'emacs-reader)

(ert-deftest emacs-reader-directory-cancel-scan-reentrant-and-restart ()
  (let* ((emacs-reader-directory (make-temp-file "reader-cancel-lib-" t))
         (source (make-temp-file "reader-cancel-src-" t))
         (emacs-reader-local--directory-imports (make-hash-table :test 'equal))
         (calls 0) result old-callback process)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-reader-file-worker-start)
                   (lambda (_op _args callback)
                     (setq old-callback callback)
                     (setq process (make-process :name "reader-cancel-test" :command '("sleep" "30")
                                                 :noquery t
                                                 :sentinel (lambda (_proc _event)
                                                             (funcall callback nil "terminated")))))))
          (should-error (emacs-reader-cancel-directory-import) :type 'user-error)
          (emacs-reader-import-directory source (lambda (value) (cl-incf calls) (setq result value)))
          (should-error (emacs-reader-import-directory source) :type 'user-error)
          (emacs-reader-cancel-directory-import)
          (should (= calls 1))
          (should (plist-get result :cancelled))
          (should-not (plist-get result :total))
          (should-not (plist-get result :errors))
          (should-error (emacs-reader-cancel-directory-import) :type 'user-error)
          (let ((previous old-callback))
            (emacs-reader-import-directory source)
            (funcall previous nil "late exit")
            (should (gethash (file-name-as-directory (expand-file-name emacs-reader-directory))
                             emacs-reader-local--directory-imports))
            (emacs-reader-cancel-directory-import)))
      (when (and process (process-live-p process)) (delete-process process))
      (delete-directory source t)
      (delete-directory emacs-reader-directory t))))

(ert-deftest emacs-reader-directory-cancel-current-book-and-stop ()
  (let* ((emacs-reader-directory (make-temp-file "reader-cancel-lib-" t))
         (source (make-temp-file "reader-cancel-src-" t))
         (emacs-reader-local--directory-imports (make-hash-table :test 'equal))
         (file1 (expand-file-name "one.txt" source))
         (file2 (expand-file-name "two.txt" source))
         (starts 0) callback result (calls 0))
    (unwind-protect
        (progn
          (with-temp-file file1 (insert "first"))
          (with-temp-file file2 (insert "second"))
          (cl-letf (((symbol-function 'emacs-reader-file-worker-start)
                     (lambda (_op args cb)
                       (cl-incf starts)
                       (if (eq (cadr args) :scan-directory)
                           (funcall cb (list :files (list file1 file2) :duplicates 0 :errors nil) nil)
                         (setq callback cb)))))
            (emacs-reader-import-directory source (lambda (value) (cl-incf calls) (setq result value)))
            (should (= starts 2))
            (emacs-reader-cancel-directory-import)
            (emacs-reader-cancel-directory-import)
            (should-not result)
            (funcall callback (emacs-reader-local--prepare-import file1 nil nil nil emacs-reader-directory) nil)
            (funcall callback nil "late")
            (should (= starts 2))
            (should (= calls 1))
            (should (plist-get result :cancelled))
            (should (= (plist-get result :done) 1))
            (should (= (plist-get result :total) 2))
            (should (= (plist-get result :added) 1))
            (should (= (length (emacs-reader-local--records "shelf")) 1))))
      (delete-directory source t)
      (delete-directory emacs-reader-directory t))))

(ert-deftest emacs-reader-directory-cancel-key ()
  (should (eq (lookup-key emacs-reader-shelf-mode-map (kbd "C-c C-k"))
              'emacs-reader-cancel-directory-import)))

(provide 'emacs-reader-directory-cancel-test)
;;; emacs-reader-directory-cancel-test.el ends here
