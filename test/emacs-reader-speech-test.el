;;; emacs-reader-speech-test.el --- Native speech tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Exercise local speech selection and the paragraph playback lifecycle.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'emacs-reader)

(ert-deftest emacs-reader-speech-native-program-order ()
  (dolist (case '((darwin ("say" "espeak-ng") ("say"))
                  (darwin ("espeak-ng") ("espeak-ng" "-b" "1" "--stdin"))
                  (gnu/linux ("say" "espeak" "espeak-ng") ("espeak-ng" "-b" "1" "--stdin"))
                  (gnu/linux ("espeak") ("espeak" "-b" "1" "--stdin"))))
    (let ((system-type (car case))
          (emacs-reader-tts-native-voice nil)
          (emacs-reader-tts-rate 1))
      (cl-letf (((symbol-function 'executable-find)
                 (lambda (name) (and (member name (nth 1 case)) name))))
        (should (equal (emacs-reader--tts-native-command) (nth 2 case))))))
  (let ((emacs-reader-tts-rate 2)
        (emacs-reader-tts-native-voice "Tingting")
        (system-type 'darwin))
    (cl-letf (((symbol-function 'executable-find) #'identity))
      (should (equal (emacs-reader--tts-native-command)
                     '("say" "-v" "Tingting" "-r" "350")))))
  (cl-letf (((symbol-function 'executable-find) (lambda (_) nil)))
    (should-error (emacs-reader--tts-native-command) :type 'user-error)))

(ert-deftest emacs-reader-speech-endpoint-takes-priority ()
  (with-temp-buffer
    (emacs-reader-reading-mode)
    (let ((inhibit-read-only t)) (insert "Text"))
    (goto-char (point-min))
    (setq emacs-reader--current-chapter-index 0 emacs-reader--requested-chapter-index 0)
    (let ((emacs-reader-tts-url "https://example.test/speech") fetched)
      (cl-letf (((symbol-function 'emacs-reader--tts-native-command) #'ert-fail)
                ((symbol-function 'emacs-reader--tts-player) #'ignore)
                ((symbol-function 'emacs-reader--tts-fetch)
                 (lambda (text _) (setq fetched text) nil)))
        (emacs-reader-toggle-read-aloud)
        (should (equal fetched "Text"))
        (emacs-reader-toggle-read-aloud)
        (setq emacs-reader-tts-url "invalid-url")
        (should-error (emacs-reader-toggle-read-aloud) :type 'user-error)
        (should-not emacs-reader--tts-active)))))

(ert-deftest emacs-reader-speech-native-follows-advances-and-stops ()
  (dolist (emacs-reader-tts-url '(nil ""))
    (with-temp-buffer
      (emacs-reader-reading-mode)
      (let ((inhibit-read-only t)) (insert "-第一段。\n\n第二段。"))
      (goto-char (point-min))
      (setq emacs-reader--current-chapter-index 0 emacs-reader--requested-chapter-index 0
            emacs-reader--current-book '((totalChapterNum . 2)))
      (let (spoken sentinel killed chapter)
        (cl-letf (((symbol-function 'emacs-reader--tts-native-command) (lambda () '("say")))
                  ((symbol-function 'emacs-reader--tts-player) #'ert-fail)
                  ((symbol-function 'emacs-reader--tts-fetch) #'ert-fail)
                  ((symbol-function 'make-process)
                   (lambda (&rest args)
                     (should (equal (plist-get args :command) '("say")))
                     (setq sentinel (plist-get args :sentinel))
                     'speaker))
                  ((symbol-function 'process-send-string) (lambda (_ text) (push text spoken)))
                  ((symbol-function 'process-send-eof) #'ignore)
                  ((symbol-function 'process-status) (lambda (_) 'exit))
                  ((symbol-function 'process-exit-status) (lambda (_) 0))
                  ((symbol-function 'process-live-p) (lambda (p) (eq p 'speaker)))
                  ((symbol-function 'delete-process) (lambda (p) (setq killed p)))
                  ((symbol-function 'emacs-reader--load-chapter)
                   (lambda (index generation) (setq chapter (list index generation)))))
          (emacs-reader-toggle-read-aloud)
          (should (equal spoken '("-第一段。")))
          (should (= (overlay-start emacs-reader--tts-overlay) (point-min)))
          (funcall sentinel 'speaker "finished")
          (should (equal spoken '("第二段。" "-第一段。")))
          (should (= (overlay-start emacs-reader--tts-overlay) (point)))
          (should (looking-at-p "第二段"))
          (let ((stale sentinel))
            (emacs-reader-toggle-read-aloud)
            (should (eq killed 'speaker))
            (should-not emacs-reader--tts-overlay)
            (emacs-reader-toggle-read-aloud)
            (funcall stale 'speaker "killed")
            (should-not chapter)
            (funcall sentinel 'speaker "finished")
            (should (equal chapter (list 1 emacs-reader--tts-generation)))
            (emacs-reader--tts-stop)))))))

(provide 'emacs-reader-speech-test)
;;; emacs-reader-speech-test.el ends here
