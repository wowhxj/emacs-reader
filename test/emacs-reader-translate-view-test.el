;;; emacs-reader-translate-view-test.el --- Translation view tests -*- lexical-binding: t; indent-tabs-mode: nil; fill-column: 100; -*-

;;; Commentary:
;; Exercise chapter formatting, overlay ownership and directory isolation.

;;; Code:

(require 'ert)
(require 'emacs-reader)
(require 'emacs-reader-translate-view)

(ert-deftest emacs-reader-translate-view-splits-formatted-chapters ()
  (dolist (formatted (list (emacs-reader--format-chapter "甲。\n乙。")
                           (emacs-reader--format-paragraphs "One\ncontinued\n\nTwo")
                           "\n　甲 \n　 \t\n\n乙\n" "" "\n　　\t "))
    (with-temp-buffer
      (insert "\n" formatted "\n")
      (emacs-reader-reading-mode)
      (should (equal (emacs-reader-translate-view-paragraphs)
                     (emacs-reader-translate-view-split formatted)))))
  (should (equal (emacs-reader-translate-view-split "\n　甲 \n　 \t\n\n乙\n") '("甲" "乙")))
  (should (equal (emacs-reader-translate-view-split "  One\n continued\n\nTwo")
                 '("One" "continued" "Two")))
  (should-not (emacs-reader-translate-view-split "\n　　\t ")))

(ert-deftest emacs-reader-translate-view-preserves-reading-buffer ()
  (dolist (suffix '("" "\n"))
    (with-temp-buffer
      (insert "\n　　First\ncontinued\n\nLast" suffix)
      (emacs-reader-reading-mode)
      (goto-char 4)
      (set-buffer-modified-p nil)
      (let ((source (buffer-string))
            (tick (buffer-chars-modified-tick))
            (speech (emacs-reader--tts-paragraph (point)))
            (highlight (make-overlay 2 8)))
        (overlay-put highlight 'face 'emacs-reader-tts-paragraph)
        (emacs-reader-translate-view-show
         (vector nil "第一段\n续行" (propertize "末段" 'display "incorrect")))
        (should (= 2 (length emacs-reader-translate-view--overlays)))
        (dolist (overlay emacs-reader-translate-view--overlays)
          (let* ((end (overlay-end overlay))
                 (display (overlay-get overlay 'after-string))
                 (last (= end (- (point-max) (length suffix)))))
            (should (equal display (if last "\n末段" "\n第一段\n续行")))
            (should (eq (get-text-property 1 'face display) 'emacs-reader-translate-view-face))
            (should-not (get-text-property 1 'display display))
            (should (eq (char-before end) (if last ?t ?d)))))
        (should (= (point) 4))
        (should (= tick (buffer-chars-modified-tick)))
        (should-not (buffer-modified-p))
        (should (equal source (filter-buffer-substring (point-min) (point-max))))
        (should (equal speech (emacs-reader--tts-paragraph (point))))
        (should (equal (emacs-reader-translate-view-paragraphs) '("First" "continued" "Last")))
        (emacs-reader-translate-view-show '(nil nil "末" "excess"))
        (should (= 1 (length emacs-reader-translate-view--overlays)))
        (emacs-reader-translate-view-clear)
        (should (equal (overlays-in (point-min) (point-max)) (list highlight)))))))

(ert-deftest emacs-reader-translate-view-interleaves-soft-lines ()
  (let ((emacs-reader-translation-line-width 10))
    (with-temp-buffer
      (insert "one two three four\n壹贰叁肆伍陆")
      (emacs-reader-reading-mode)
      (should (equal (emacs-reader-translate-view-paragraphs)
                     '("one two" "three four" "壹贰叁肆伍" "陆")))
      (emacs-reader-translate-view-show '("甲" "乙" "A" "B"))
      (should (equal (mapcar (lambda (ov) (overlay-get ov 'after-string))
                             (reverse emacs-reader-translate-view--overlays))
                     '("\n甲\n" "\n乙" "\nA\n" "\nB"))))))

(ert-deftest emacs-reader-translate-view-samples-native-window ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (let* ((window (selected-window))
             (text (concat "　　" (make-string 19 ?x) "     "
                           (make-string 190 ?a) "　　 \n\n"
                           (apply #'concat (make-list 20 "甲乙，丙丁。"))))
             (truncate-partial-width-windows nil)
             expected)
        (set-window-buffer window (current-buffer))
        (insert text)
        (emacs-reader-reading-mode)
        (set-window-margins window 3 4)
        (should (eq window (emacs-reader-translate-view-layout-window)))
        (goto-char (point-min))
        (while (< (point) (point-max))
          (let ((start (point)))
            (vertical-motion 1 window)
            (should (> (point) start))
            (let* ((end (if (eq (char-before) ?\n) (1- (point)) (point)))
                   (line (string-trim (buffer-substring start end) "[ 　]+" "[ 　]+")))
              (unless (string-empty-p line) (push (cons line end) expected)))))
        (setq expected (nreverse expected))
        (let* ((lines (mapcar #'car expected))
               (translations (make-list (length lines) (make-string 160 ?译)))
               (emacs-reader-translation-line-width 5))
          (should (> (length lines) 3))
          (should (> (length (car lines)) 5))
          (should (equal (emacs-reader-translate-view-paragraphs) lines))
          (emacs-reader-translate-view-append 0 translations)
          (let ((ranges emacs-reader-translate-view--line-ranges))
            (emacs-reader-translate-view-show translations)
            (should (eq ranges emacs-reader-translate-view--line-ranges)))
          (should (equal (mapcar #'overlay-end (reverse emacs-reader-translate-view--overlays))
                         (mapcar #'cdr expected)))
          (should (equal (emacs-reader-translate-view-paragraphs) lines))
          (let ((other (split-window-below)) (reader (current-buffer)))
            (select-window other)
            (with-temp-buffer
              (set-window-buffer other (current-buffer))
              (should (equal (emacs-reader-translate-view-split text 5 window) lines))
              (should (eq (selected-window) other))
              (should (eq reader (window-buffer window))))))))))

(ert-deftest emacs-reader-translate-view-chapter-and-toc-lifecycle ()
  (with-temp-buffer
    (insert "Chapter one")
    (emacs-reader-reading-mode)
    (emacs-reader-translate-view-show '("译一"))
    (let ((inhibit-read-only t))
      (erase-buffer)
      (insert "Chapter two"))
    (should-not (overlays-in (point-min) (point-max)))
    (emacs-reader-translate-view-show '("译二"))
    (let ((old (car emacs-reader-translate-view--overlays)))
      (emacs-reader-toc-mode)
      (should-not (overlay-buffer old)))
    (let ((existing (overlays-in (point-min) (point-max))))
      (should-not (emacs-reader-translate-view-paragraphs))
      (emacs-reader-translate-view-show '("目录译文"))
      (should (equal (overlays-in (point-min) (point-max)) existing)))))

(ert-deftest emacs-reader-translate-view-appends-without-rescanning ()
  (with-temp-buffer
    (insert "One\nTwo\nThree\nFour")
    (emacs-reader-reading-mode)
    (let ((scan (symbol-function 'emacs-reader-translate-view--ranges)) (calls 0))
      (cl-letf (((symbol-function 'emacs-reader-translate-view--ranges)
                 (lambda (&optional window) (cl-incf calls) (funcall scan window))))
        (emacs-reader-translate-view-paragraphs)
        (emacs-reader-translate-view-append 2 ["三" nil "多余"])
        (let ((third (car emacs-reader-translate-view--overlays)))
          (should (= (overlay-end third) 14))
          (narrow-to-region 5 8)
          (emacs-reader-translate-view-append 0 '("一" "　"))
          (emacs-reader-translate-view-append 2 ["三"])
          (emacs-reader-translate-view-append 2 ["叁"])
          (should (equal (overlay-get third 'after-string) "\n叁"))
          (should (eq (overlay-buffer third) (current-buffer)))
          (should (= 5 (point-min)))
          (widen)
          (should (= 2 (length (overlays-in (point-min) (point-max)))))
          (should (= calls 1))
          (let ((inhibit-read-only t))
            (goto-char (point-min))
            (insert "New\n"))
          (emacs-reader-translate-view-append 1 ["更新"])
          (should-not (overlay-buffer third))
          (should (= (overlay-end (car emacs-reader-translate-view--overlays)) 8))
          (should (= calls 2))
          (emacs-reader-translate-view-clear)
          (emacs-reader-translate-view-append 0 ["新"])
          (should (= calls 3)))))))

(provide 'emacs-reader-translate-view-test)
;;; emacs-reader-translate-view-test.el ends here
