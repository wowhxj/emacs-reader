;;; emacs-reader-search-filter-test.el --- Search filtering tests -*- lexical-binding: t; indent-tabs-mode: nil; fill-column: 100; -*-

;;; Commentary:
;; Exercise live result filtering with deterministic provider callbacks.

;;; Code:
(require 'ert)
(require 'emacs-reader-search-all)

(ert-deftest emacs-reader-search-access-for-same-title ()
  (let* ((emacs-reader--catalog-access (make-hash-table :test #'equal))
         (book '((name . "三国演义") (origin . "宜搜") (bookUrl . "one")
                 (readerType . "legado") (accessLabel . "含收费章节")))
         (other '((name . "三国演义") (origin . "其他") (bookUrl . "two")))
         (chapters '(((native . (:access free))) ((native . (:access paid))))))
    (with-temp-buffer
      (emacs-reader-search-mode)
      (setq emacs-reader--search-books (list book other))
      (emacs-reader--render-search)
      (should (string-search "含收费章节" (buffer-string)))
      (emacs-reader--remember-access book chapters)
      (emacs-reader-filter--set "部分收费")
      (should (equal (mapcar #'car tabulated-list-entries) (list book)))
      (should (equal (alist-get 'name book) "三国演义")))
    (with-temp-buffer
      (emacs-reader-all-mode)
      (setq emacs-reader-all--seen (make-hash-table :test #'equal))
      (emacs-reader-all--append '((type . "legado") (name . "宜搜") (url . "宜搜"))
                                '((:name "三国演义" :origin "宜搜" :bookUrl "one")))
      (emacs-reader-all--render)
      (should (string-search "[部分收费] 三国演义" (buffer-string))))))

(ert-deftest emacs-reader-search-filter-single-source-page ()
  (with-temp-buffer
    (emacs-reader-search-mode)
    (should (eq (key-binding "/") #'emacs-reader-filter-edit))
    (let ((a '((name . "A") (origin . "src") (bookUrl . "a")))
          (b '((name . "B") (author . "match") (origin . "src") (bookUrl . "b")))
          cb opened)
      (cl-letf (((symbol-function 'emacs-reader--reader3-request)
                 (lambda (_endpoint _method _data done) (setq cb done)))
                ((symbol-function 'emacs-reader-open-book)
                 (lambda (book _) (setq opened book))))
        (setq emacs-reader--search-config '(:source "src" :page 1))
        (emacs-reader-search-more)
        (emacs-reader-filter--set "match")
        (funcall cb `(:ok ((isSuccess . t) (data . (,a)))))
        (should-not tabulated-list-entries)
        (emacs-reader-search-more)
        (funcall cb nil)
        (call-interactively (key-binding "g"))
        (funcall cb `(:ok ((isSuccess . t) (data . (,a ,b)))))
        (should (equal emacs-reader--search-books (list a b)))
        (should (equal (mapcar #'car tabulated-list-entries) (list b)))
        (goto-char (point-min))
        (call-interactively (key-binding (kbd "RET")))
        (should (eq opened b))
        (call-interactively (key-binding (kbd "C-c C-l")))
        (should (equal (mapcar #'car tabulated-list-entries) (list a b)))))))

(ert-deftest emacs-reader-search-filter-aggregate-retry ()
  (let* ((src '((name . "Catalog") (type . "json")))
         (a (emacs-reader-opds--item :kind 'record :label "Hidden" :url "a"))
         (b (emacs-reader-opds--item :kind 'download :label "Visible" :url "b"))
         page done added)
    (save-window-excursion
      (cl-letf (((symbol-function 'emacs-reader--display-buffer) #'switch-to-buffer)
                ((symbol-function 'emacs-reader-catalog-search-pages)
                 (lambda (_src _query p d) (setq page p done d) #'ignore))
                ((symbol-function 'emacs-reader-catalog-open-item)
                 (lambda (source item add) (setq added (list source item add)))))
        (emacs-reader-search-all "books" (list src))
        (unwind-protect
            (progn
              (should (eq (key-binding "/") #'emacs-reader-filter-edit))
              (funcall page (list a))
              (emacs-reader-filter--set "Catalog Visible")
              (funcall done "fail")
              (should-not tabulated-list-entries)
              (should (string-search "Catalog Visible" header-line-format))
              (call-interactively (key-binding "g"))
              (funcall page (list a b))
              (funcall done nil)
              (should (= 1 (length tabulated-list-entries)))
              (goto-char (point-min))
              (call-interactively (key-binding "a"))
              (should (equal added (list src b t)))
              (call-interactively (key-binding (kbd "C-c C-l")))
              (should (= 2 (length tabulated-list-entries))))
          (kill-buffer (current-buffer)))))))

(ert-deftest emacs-reader-search-filter-catalog-buttons ()
  (with-temp-buffer
    (emacs-reader-opds-mode)
    (let* ((a (emacs-reader-opds--item :kind 'record :label "Hidden"))
           (dl (emacs-reader-opds--item :kind 'download :label "EPUB"))
           (b (emacs-reader-opds--item :kind 'record :label "Visible" :title "Work"
                                       :action (lambda ()
                                                 (emacs-reader-opds--show "Work" (list dl)))))
           page done)
      (cl-letf (((symbol-function 'emacs-reader-catalog--search)
                 (lambda (_src _query p d &rest _) (setq page p done d) #'ignore)))
        (emacs-reader-opds--search-buffer nil "books")
        (should (eq (key-binding "/") #'emacs-reader-filter-edit))
        (emacs-reader-filter--set "Visible")
        (funcall page (list a))
        (funcall page (list b))
        (funcall done "offline")
        (should (string-search "Visible" header-line-format))
        (should-not (string-search "Hidden" (buffer-string)))
        (should (eq b (button-get (next-button (point-min)) 'emacs-reader-item)))
        (emacs-reader-filter--set "none")
        (should (equal "重试" (button-label (next-button (point-min)))))
        (button-activate (next-button (point-min)))
        (funcall page (list a b))
        (funcall done nil)
        (should-not (next-button (point-min)))
        (should (equal (cdar emacs-reader-opds--history) (list a b)))
        (emacs-reader-filter--set "Visible")
        (button-activate (next-button (point-min)))
        (should (eq dl (button-get (previous-button (point-max)) 'emacs-reader-item)))
        (should-not emacs-reader-opds-result-mode)
        (emacs-reader-opds-back)
        (should-not (string-search "Hidden" (buffer-string)))
        (should (eq b (button-get (next-button (point-min)) 'emacs-reader-item)))
        (call-interactively (key-binding (kbd "C-c C-l")))
        (should (eq a (button-get (next-button (point-min)) 'emacs-reader-item)))))))

(provide 'emacs-reader-search-filter-test)
;;; emacs-reader-search-filter-test.el ends here
